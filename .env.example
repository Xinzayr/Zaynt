# ZAYNT - Variables de entorno
# ============================
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local ni archivos .env* a git (ver .gitignore).
# En Vercel: Project Settings → Environment Variables.

# ---- PÚBLICAS (prefijo NEXT_PUBLIC_) ----
# Se inyectan en el bundle del cliente. No pongas secretos aquí.

# URL base del sitio (dominio pendiente; en Vercel usa la URL de preview/producción)
NEXT_PUBLIC_SITE_URL=https://zaynt.vercel.app

# Nombre del sitio mostrado en la UI y metadatos
NEXT_PUBLIC_SITE_NAME=ZAYNT

# WhatsApp Business (solo dígitos con código de país; sin el cero local inicial)
# Nota: este número es público por naturaleza al usarse en enlaces wa.me
NEXT_PUBLIC_WHATSAPP_GENERAL=593983955959

# Enlace público a la página de Facebook
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/profile.php?id=61595018891608

# Microsoft Clarity (public project identifier; analytics is not loaded before consent)
NEXT_PUBLIC_CLARITY_PROJECT_ID=yw7vqncc63

# ---- SERVIDOR / SECRETAS (sin prefijo NEXT_PUBLIC_) ----
# Solo disponibles en Server Components, API routes y middleware.
# Todas son OPCIONALES hasta la Etapa 4 (Novedades).

# Fuente de novedades: "static" (data/news.ts) | "facebook" (Graph API)
# NEWS_SOURCE=static

# Facebook Graph API (requeridos solo si NEWS_SOURCE=facebook)
# FACEBOOK_PAGE_ID=61595018891608
# FACEBOOK_PAGE_ACCESS_TOKEN=EAA...
# FACEBOOK_GRAPH_API_VERSION=v20.0

# Segundos de revalidación del caché de novedades (ISR)
# NEWS_REVALIDATE_SECONDS=3600

# Secreto para autenticar el endpoint /api/news/refresh (cron/VPN)
# Genera uno seguro: openssl rand -hex 32
# CRON_SECRET=tu_secreto_largo_y_aleatorio